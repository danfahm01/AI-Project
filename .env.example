# Copy to .env (repo root, used by docker compose and the backend) and fill in.
# Never commit .env.

# --- Application ------------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
ENABLE_API_DOCS=true

# --- Auth -------------------------------------------------------------------
# Required in production (>= 32 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If empty in development, a random per-process secret is used.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Database ---------------------------------------------------------------
# Local development without Docker uses SQLite:
DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
# docker compose overrides DATABASE_URL to point at its PostgreSQL service and
# reads these values:
POSTGRES_DB=assistant
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
# PostgreSQL connections per API worker. Keep
# WEB_CONCURRENCY x (POOL_SIZE + MAX_OVERFLOW) below max_connections (default 100).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Redis (rate limiting) --------------------------------------------------
# Empty = in-process limiter (single worker only). docker compose sets this.
REDIS_URL=

# --- HTTP -------------------------------------------------------------------
# Comma-separated list of allowed browser origins in production.
CORS_ORIGINS=
# Allow http://localhost:<any port> (Flutter web dev server). Must be false in production.
CORS_ALLOW_LOCALHOST=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
# AI replies (send + regenerate) per user per minute.
RATE_LIMIT_CHAT_PER_MINUTE=20
# Voice sessions started per user per minute (each mints a provider client secret).
RATE_LIMIT_VOICE_SESSIONS_PER_MINUTE=6
HTTP_PORT=80

# --- AI providers (server-side only; never shipped to the apps) -------------
# OpenAI (Responses API). Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Models offered in the app (comma-separated). Verified on 2026-11-20 against
# https://developers.openai.com/api/docs/models
OPENAI_MODELS=gpt-6.2-astra,gpt-6.2-sol,gpt-6-luna
OPENAI_DEFAULT_MODEL=gpt-6.2-astra
# Optional: OpenAI-compatible gateway. Leave empty for the official API.
OPENAI_BASE_URL=
# Realtime voice (speech-to-speech over WebRTC). Verified on 2026-11-20 against
# https://developers.openai.com/api/docs/guides/realtime-webrtc . Empty disables voice.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICES=marin,cedar,alloy,ash,ballad,coral,echo,sage,shimmer,verse
OPENAI_REALTIME_DEFAULT_VOICE=marin
# Live transcription of the user's speech (shown on screen and saved to the conversation).
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper

# Google Gemini (Gemini API + Live API). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Text models (comma-separated). Verified on 2026-11-21 against
# https://aistudio.google.com/docs/models
GEMINI_MODELS=gemini-4-hydrogen,gemini-4-carbon,gemini-3.5-flash-lite
GEMINI_DEFAULT_MODEL=gemini-4-hydrogen
# Live API native-audio model for voice (speech-to-speech over WebSocket). Empty disables Gemini voice.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Prebuilt voices (speech-generation guide; native-audio Live models accept them).
GEMINI_LIVE_VOICES=Zephyr,Puck,Charon,Kore,Fenrir,Leda,Orus,Aoede,Callirrhoe,Autonoe,Enceladus,Iapetus,Umbriel,Algieba,Despina,Erinome,Algenib,Rasalgethi,Laomedeia,Achernar,Alnilam,Schedar,Gacrux,Pulcherrima,Achird,Zubenelgenubi,Vindemiatrix,Sadachbia,Sadaltager,Sulafat
GEMINI_LIVE_DEFAULT_VOICE=Kore
# Ephemeral Live API tokens only work with v1beta.
GEMINI_API_VERSION=v1beta
# Optional: the local test server (tests/fakes/fake_gemini_server.py). Empty = official endpoint.
GEMINI_BASE_URL=

# Ollama: models that run on this computer, no API key (https://ollama.com/download, then
# e.g. `ollama pull gemma4:e4b`). Empty = disabled. start-local.ps1 sets it when Ollama runs.
# From Docker containers use http://host.docker.internal:11434.
OLLAMA_BASE_URL=
# Installed models offered in the app (comma-separated). Empty = every installed chat model.
OLLAMA_ALLOWED_MODELS=
OLLAMA_DEFAULT_MODEL=

# Provider used when a user has not chosen one (openai | gemini | ollama). Empty = the first configured.
DEFAULT_AI_PROVIDER=
AI_REQUEST_TIMEOUT_SECONDS=120

# --- Chat behaviour ---------------------------------------------------------------
# CHAT_SYSTEM_PROMPT="You are a helpful assistant..."   (default is built in)
# CHAT_MAX_OUTPUT_TOKENS=                                (empty = model default)
CHAT_HISTORY_MAX_CHARS=60000
# Messages read from the database per reply (newest first), within the budget above.
CHAT_HISTORY_MAX_MESSAGES=200

# --- Voice behaviour --------------------------------------------------------------
# VOICE_SYSTEM_PROMPT="You are a friendly, helpful voice assistant..."   (default is built in)
# Lifetime of the client secret handed to the app (10-7200 s): the time allowed
# to connect. An established call keeps running.
VOICE_TOKEN_TTL_SECONDS=120
# Longest voice session (60-72000 s). Gemini Live tokens stop working after this,
# including reconnects with session resumption.
VOICE_SESSION_MAX_SECONDS=1800
# Earlier conversation text given to the voice model as context.
VOICE_CONTEXT_MAX_CHARS=6000

# --- Attachments (images and PDFs in chat) ------------------------------------------
# Where uploaded files are stored (docker compose mounts a volume at /app/data/attachments).
ATTACHMENT_STORAGE_DIR=./data/attachments
# Per file, in bytes (default 10 MB). OpenAI accepts files under 50 MB; Gemini's inline limit is 20 MB per request.
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENTS_PER_MESSAGE=5
# Raw bytes of attachments sent with one AI request (base64 adds a third). Newest files
# first; older ones beyond this are mentioned by name instead of being resent.
ATTACHMENT_CONTEXT_MAX_BYTES=12582912
# Uploads never sent with a message are deleted after this many hours.
ATTACHMENT_PENDING_TTL_HOURS=24
# Lifetime of signed download links (opening a PDF in a browser or viewer).
ATTACHMENT_LINK_TTL_SECONDS=300
RATE_LIMIT_UPLOADS_PER_MINUTE=30

# --- Web app from the API server (scripts/start-local.ps1 sets WEB_APP_DIR) ----------
# A Flutter web build made with API_BASE_URL=/, served at / without Nginx. Empty = API only.
WEB_APP_DIR=
# Hosts the web app connects to directly in voice mode (its Content-Security-Policy).
WEB_CSP_CONNECT_SRC=https://api.openai.com wss://generativelanguage.googleapis.com

# --- Production (docker-compose.prod.yml, see docs/deployment.md) --------------------
# Your domain. Required by the production overlay.
SERVER_NAME=
HTTPS_PORT=443
# API worker processes in the backend container.
WEB_CONCURRENCY=2
# TLS certificate. Default: fullchain.pem + privkey.pem in TLS_CERT_DIR.
TLS_CERT_DIR=./infrastructure/certs
# Let's Encrypt instead (after the first `certbot certonly`):
# TLS_CERTIFICATE=/etc/letsencrypt/live/<SERVER_NAME>/fullchain.pem
# TLS_CERTIFICATE_KEY=/etc/letsencrypt/live/<SERVER_NAME>/privkey.pem
# Released images instead of building on the server:
# BACKEND_IMAGE=ghcr.io/<owner>/<repo>/backend:1.0.0
# WEB_IMAGE=ghcr.io/<owner>/<repo>/web:1.0.0
